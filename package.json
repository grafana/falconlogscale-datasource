{
  "name": "grafana-falconlogscale-datasource",
  "version": "1.10.1",
  "description": "Falcon LogScale data source plugin for Grafana",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e:playwright": "npx playwright test",
    "e2e:playwright:ui": "npx playwright test --ui",
    "e2e:playwright:report": "npx playwright show-report",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\"",
    "start": "npm run dev",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@grafana/e2e-selectors": "13.2.1",
    "@grafana/eslint-config": "9.0.0",
    "@grafana/plugin-e2e": "3.11.1",
    "@grafana/sign-plugin": "3.3.3",
    "@grafana/tsconfig": "2.2.0",
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin-ts": "3.1.0",
    "@swc/core": "1.16.1",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-router-dom": "5.3.3",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "copy-webpack-plugin": "14.0.0",
    "cspell": "10.2.0",
    "css-loader": "7.1.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-webpack-plugin": "5.0.3",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "jest-fetch-mock": "3.2.0",
    "jest-mock-extended": "4.0.1",
    "prettier": "3.9.6",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.103.1",
    "sass-loader": "16.0.8",
    "semver": "7.8.5",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "webpack": "5.110.3",
    "webpack-cli": "6.0.1",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.2.1",
    "@grafana/i18n": "13.2.1",
    "@grafana/plugin-ui": "0.17.4",
    "@grafana/runtime": "13.2.1",
    "@grafana/schema": "13.2.1",
    "@grafana/ui": "13.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "5.3.4",
    "react-select-event": "5.5.1",
    "react-use": "17.6.1",
    "tslib": "2.8.1"
  },
  "packageManager": "npm@12.0.2",
  "overrides": {
    "rxjs": "7.8.2"
  },
  "engines": {
    "node": ">=24"
  }
}
